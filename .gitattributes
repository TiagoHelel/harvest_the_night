# The tooling writes LF; keep it that way so 159 future task commits do not
# churn line endings. Godot and Python are both happy with LF on Windows.
* text=auto eol=lf
*.png binary
*.exe binary
*.wasm binary
*.pck binary
# Submitted prompts are hashed as bytes; retain their exact saved newlines.
implementation/sprites/generation/0014-*.prompt.txt -text whitespace=cr-at-eol
