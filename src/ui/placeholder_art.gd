# ---------------------------------------------------------------- the lookup

## A raster path's geometry - `canvas`, `pivot`, `seconds`, `loop`,
## `draw_scale`... - from the real art if it exists and from the stand-in's
## entry if not. Empty for a path neither knows.
static func frame(path: String) -> Dictionary:
	if RasterArt.FRAMES.has(path):
		return RasterArt.FRAMES[path]
	var at := _registered(path)
	if at.is_empty():
		return {}
	var entry: Dictionary = POSES[at[0]]
	var shape: Dictionary = entry["geometry"]
	return {
		"canvas": shape["canvas"],
		"pivot": shape["pivot"],
		"cell_offset": Vector2i.ZERO,
		"seconds": entry["seconds"],
		"loop": entry["loop"],
		"draw_scale": shape["draw_scale"],
		"stand_in": entry["pack"],
	}


## Whether anything - real art or a stand-in - answers for this path.
static func has_frame(path: String) -> bool:
	return RasterArt.FRAMES.has(path) or not _registered(path).is_empty()


## The file to load for a path: the path itself, or the stand-in's file while
## the real one has not arrived.
static func texture_path(path: String) -> String:
	if RasterArt.FRAMES.has(path):
		return path
	var at := _registered(path)
	if at.is_empty():
		return path
	return stand_in_path(at[0], int(at[1]))


## Whether a farmer animation is drawn by a stand-in.
static func has_pose(name: StringName) -> bool:
	return POSES.has(name)


## The registered entry for a farmer animation, or empty.
static func pose(name: StringName) -> Dictionary:
	return POSES.get(name, {})


## The stand-in's file for one frame of a registered farmer animation.
static func stand_in_path(name: StringName, frame_index: int) -> String:
	var stand_in := StringName(POSES[name]["stand_in"])
	var frames := maxi(int(PlayerFrames.COUNT.get(stand_in, 1)), 1)
	return "%s%s_%d.png" % [DIR, stand_in, frame_index % frames]


## `[name, frame]` for a registered runtime path, or empty.
static func _registered(path: String) -> Array:
	if not path.begins_with(DIR) or not path.ends_with(".png"):
		return []
	var stem := path.get_file().get_basename()
	var cut := stem.rfind("_")
	if cut <= 0 or not stem.substr(cut + 1).is_valid_int():
		return []
	var name := StringName(stem.substr(0, cut))
	var index := int(stem.substr(cut + 1))
	if not POSES.has(name) or index < 0 or index >= int(POSES[name]["frames"]):
		return []
	return [name, index]
