# ---------------------------------------------------------------- the lookup

## A raster path's geometry - `canvas`, `pivot`, `seconds`, `loop`,
## `draw_scale`... - from the real art if it exists and from the stand-in's
## entry if not. Empty for a path neither knows.
static func frame(path: String) -> Dictionary:
	if RasterArt.FRAMES.has(path):
		return RasterArt.FRAMES[path]
	var at := _registered(path)
	if at.is_empty():
		return {}
	var entry := _entry(at[0])
	var shape: Dictionary = entry["geometry"]
	var answer := {
		"canvas": shape["canvas"],
		"pivot": shape["pivot"],
		"cell_offset": Vector2i.ZERO,
		"seconds": entry["seconds"],
		"loop": entry["loop"],
		"draw_scale": shape["draw_scale"],
		"stand_in": entry["pack"],
	}
	# The emission points the real frames will carry (A003's `light_xy` and
	# `lights_xy`), on the frames that are lit.
	var lights: Array = entry.get("lights", [])
	if not lights.is_empty() and int(at[1]) >= int(entry.get("lit_from", 0)):
		answer["light"] = lights[0]
		answer["lights"] = lights.duplicate()
	return answer


## Whether anything - real art or a stand-in - answers for this path.
static func has_frame(path: String) -> bool:
	return RasterArt.FRAMES.has(path) or not _registered(path).is_empty()


## The file to load for a path: the path itself, or the stand-in's file while
## the real one has not arrived.
static func texture_path(path: String) -> String:
	if RasterArt.FRAMES.has(path):
		return path
	var at := _registered(path)
	if at.is_empty():
		return path
	if ART.has(at[0]):
		var stand_in := String(ART[at[0]]["stand_in"])
		# Drawn by code: there is no file to load (`is_drawn`).
		if stand_in.is_empty():
			return ""
		if int(ART[at[0]].get("stand_in_frames", 1)) > 1:
			stand_in += "_%d" % int(at[1])
		return "res://sprites/%s.png" % stand_in
	return stand_in_path(at[0], int(at[1]))


## Whether this runtime path is drawn by code until its pack lands (task
## 0131): the view draws its shape instead of loading a file.
static func is_drawn(path: String) -> bool:
	if RasterArt.FRAMES.has(path):
		return false
	var at := _registered(path)
	return not at.is_empty() and ART.has(at[0]) \
		and StringName(ART[at[0]]["stand_in"]) == &""


## The runtime path of one frame of an `ART` animation - where its pack will
## deliver it - for the lookups above.
static func art_path(name: StringName, frame_index: int) -> String:
	if bool(ART[name].get("bare", false)):
		return "%s%s.png" % [str(ART[name]["dir"]), name]
	return "%s%s_%d.png" % [str(ART[name]["dir"]), name, frame_index]


## The `ART` entry for a name, or empty.
static func art(name: StringName) -> Dictionary:
	return ART.get(name, {})


## An `ART` stand-in's colour and size (task 0156): an existing texture,
## tinted and scaled to stand for something else - A021's nodes are the iron
## ore and the seam recoloured, its stump the chopped tree's at twice the
## size. White and 1 for anything else, real art included.
static func art_tint(name: StringName) -> Color:
	return (ART.get(name, {}) as Dictionary).get("tint", Color.WHITE)


static func art_scale(name: StringName) -> float:
	return float((ART.get(name, {}) as Dictionary).get("stand_in_scale", 1.0))


## The part of an `ART` stand-in's file that stands in (task 0158): A011's heads
## are a 16x16 box of a walk frame. An empty rect - the whole file - for
## anything else, real art included.
static func art_region(name: StringName) -> Rect2i:
	return (ART.get(name, {}) as Dictionary).get("stand_in_region", Rect2i())


## Whether a farmer animation is drawn by a stand-in.
static func has_pose(name: StringName) -> bool:
	return POSES.has(name)


## The registered entry for a farmer animation, or empty.
static func pose(name: StringName) -> Dictionary:
	return POSES.get(name, {})


## The stand-in's file for one frame of a registered farmer animation.
static func stand_in_path(name: StringName, frame_index: int) -> String:
	var stand_in := StringName(POSES[name]["stand_in"])
	var frames := maxi(int(PlayerFrames.COUNT.get(stand_in, 1)), 1)
	return "%s%s_%d.png" % [DIR, stand_in, frame_index % frames]


## The stand-in's colour for a registered animation - white for anything
## else, real art included, so the view sets it without asking which it is.
static func stand_in_tint(name: StringName) -> Color:
	return (POSES.get(name, {}) as Dictionary).get("tint", Color.WHITE)


## The stand-in's turn about the feet for one frame, in degrees - 0 for an
## entry without a `turn`, and for anything that is not a stand-in.
static func stand_in_turn(name: StringName, frame_index: int) -> float:
	var turns: Array = (POSES.get(name, {}) as Dictionary).get("turn", [])
	if turns.is_empty():
		return 0.0
	return float(turns[clampi(frame_index, 0, turns.size() - 1)])


## `[name, frame]` for a registered runtime path, or empty.
static func _registered(path: String) -> Array:
	if not path.ends_with(".png"):
		return []
	var stem := path.get_file().get_basename()
	var bare: Dictionary = ART.get(StringName(stem), {})
	if bool(bare.get("bare", false)) and path.get_base_dir() + "/" == str(bare["dir"]):
		return [StringName(stem), 0]
	var cut := stem.rfind("_")
	if cut <= 0 or not stem.substr(cut + 1).is_valid_int():
		return []
	var name := StringName(stem.substr(0, cut))
	var index := int(stem.substr(cut + 1))
	var entry := _entry(name)
	if entry.is_empty() or path.get_base_dir() + "/" != str(entry.get("dir", DIR)) \
			or index < 0 or index >= int(entry["frames"]):
		return []
	return [name, index]


## A name's entry in either table: the farmer's `POSES`, or `ART`.
static func _entry(name: StringName) -> Dictionary:
	if POSES.has(name):
		return POSES[name]
	return ART.get(name, {})
