; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HARVEST THE NIGHT"
config/description="A cozy farming game where your farm is also your fortress. By day, plant, fish, mine and produce. When you choose, switch reality: the same farm becomes the map you defend against the horde."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.054902, 0.047059, 0.098039, 1)
boot_splash/show_image=false

[importer_defaults]

; Pixel art, imported exactly as generated: no mipmaps, no compression, and no
; 3D detection quietly turning either of them back on. Filtering is nearest
; project-wide via rendering/textures/canvas_textures/default_texture_filter.
texture={
"compress/mode": 0,
"compress/high_quality": false,
"compress/normal_map": 0,
"compress/channel_pack": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"roughness/mode": 0,
"process/fix_alpha_border": false,
"process/premult_alpha": false,
"process/normal_map_invert_y": false,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/size_limit": 0,
"detect_3d/compress_to": 0
}

[autoload]

; Application services, not rules. src/core/ cannot see these and must not:
; they are nodes, they touch the disk, and they are not deterministic.
Settings="*res://src/app/settings.gd"

[display]

; 480x270 is 16:9 at 30x17 tiles of 16px, and scales to 1080p at exactly 4x.
; The farm grid is 40x18 tiles, so the camera shows about three quarters of it
; at once - the design document's "1.2 to 1.5 screens wide, one tall".
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810

; Integer scaling only. Half a pixel is a bug in this game, not a look.
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

; gl_compatibility, not forward_plus: the Web export needs it, and task 0100
; promises the browser build plays identically to the desktop one.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Nearest neighbour everywhere. Anything else smears the art.
textures/canvas_textures/default_texture_filter=0

[input]

; Named actions rather than keycodes at the call site, so task 0095 can make
; them rebindable without hunting through the UI for raw keys.
debug_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194334,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
