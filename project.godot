; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HARVEST THE NIGHT"
config/description="A cozy farming game where your farm is also your fortress. By day, plant, fish, mine and produce. When you choose, switch reality: the same farm becomes the map you defend against the horde."
config/version="0.1.0"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.054902, 0.047059, 0.098039, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Settings="*res://src/app/settings.gd"
Audio="*res://src/app/audio.gd"
App="*res://src/app/app.gd"
Video="*res://src/app/video.gd"
Actions="*res://src/app/input_actions.gd"
Locale="*res://src/app/i18n.gd"
Access="*res://src/app/a11y.gd"

[debug]

debug/file_logging/enable_file_logging=true
debug/file_logging/log_path="user://logs/harvest.log"
debug/file_logging/max_log_files=5

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

